ANTHROPIC_API_KEY=

# SMTP for the 08:00 IST brief to ram.narayan@avendusspark.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_SENDER=bse-monitor@example.com
